    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-grid-layout": "^2.2.2",
    "react-i18next": "^17.0.2",
