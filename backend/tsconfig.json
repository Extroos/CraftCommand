{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@features/*": ["src/features/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*", "scripts/**/*", "../shared/**/*"],
  "exclude": ["node_modules"],
  "ts-node": {
    "files": true,
    "require": ["tsconfig-paths/register"]
  }
}
